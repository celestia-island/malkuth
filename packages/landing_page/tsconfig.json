{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@celestia-island/hikari/styles": [
        "./node_modules/@celestia-island/hikari/src/styles/index.scss"
      ],
      "@celestia-island/hikari/theme/*": [
        "./node_modules/@celestia-island/hikari/src/theme/*"
      ],
      "@celestia-island/hikari/components/*": [
        "./node_modules/@celestia-island/hikari/src/components/*"
      ],
      "@celestia-island/hikari/runtime": [
        "./node_modules/@celestia-island/hikari/src/runtime/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ]
}
